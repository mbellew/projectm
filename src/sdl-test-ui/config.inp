# config.inp
# Configuration File for projectM

Mesh X  = 708                   # Width of PerPixel Equation mesh
Mesh Y  = 400                   # Height of PerPixel Equation mesh
FPS     = 60                    # Frames Per Second
Smooth Transition Duration = 1  # in seconds
Preset Duration = 10            # in seconds
Hard Cuts Enabled = false       # Hard Cuts are preset transitions that occur when your music becomes louder. They only occur after a hard cut duration threshold has passed.
Hard Cut Duration = 60          # Number of seconds before you become eligible for a hard cut.
Hard Cut Sensitivity = 1.0      # Volume sensitivity before a hard cut is triggered.
Beat Sensitivity = 1.0          # Beat Sensitivity impacts how reactive your visualizations are to volume, bass, mid-range, and treble. Default 1.0. Range: 0 - 5 (from "dead" to VERY reactive).

# mostly ignored in projectM-SDL
#Texture Size = 1024			# Size of internal rendering texture
Window Width  = 512            # startup window width
Window Height = 512            # startup window height
Fullscreen  = false
Easter Egg Parameter = 1
Aspect Correction = true	# Custom Shape Aspect Correction
Preset Path = presets # preset location
Title Font = Vera.ttf
Menu Font = VeraMono.ttf

# Audio/video capture (SDL test UI). All optional.
#Audio Devices = BlackHole, MacBook   # preference-ordered, case-insensitive name substrings
#Video Devices = FaceTime             # preference-ordered camera name substrings (e.g. OBS, FaceTime)
# Selecting a Luxonis OAK depth camera: include "OAK" or "Luxonis" in Video Devices.
# Requires building with -DENABLE_LUXONIS=ON (depthai-core). The OAK backend derives a
# depth-based foreground mask and feeds it as alpha; the library refines the edges.
#Video Devices = OAK
# Foreground masking for a plain webcam (the OAK path sets this automatically):
#   off (default) | source | const | motion | decay | chroma | bgsub | seg   (append -raw to skip refine)
# "seg" = ONNX person segmentation (Robust Video Matting) on the webcam color frame: a clean,
# time-aligned person matte. Requires building with -DENABLE_ONNX_SEG=ON and a model at
# ~/.projectM/models/rvm_mobilenetv3.onnx (override with Video Seg Model / $PROJECTM_SEG_MODEL).
#Video Mask = seg
# Seg quality 1/2/3 -> 256/384/512 processing size (higher = crisper, slower). Default 2.
#Video Seg Quality = 2
# Optional second seg model: its matte combines with the primary's, e.g. a soft RVM matte
# clipped to people by a person-class model. Leave unset to use the single model alone.
# $PROJECTM_SEG_MODEL2 overrides.
#Video Seg Model 2 = ~/.projectM/models/u2net_human_seg.onnx
# How the second model's matte combines with the primary's ($PROJECTM_SEG_COMBINE overrides):
#   multiply (default) = primary * secondary
#   gate               = pass the primary where the secondary is present, reject (zero) elsewhere
#                        (preserves the primary's edges; $PROJECTM_SEG_GATE sets the cutoff, def 0.5)
#Video Seg Combine = multiply
# Optional body-pose tracking (drives the pose->touch bridge that moves the preset touch_*
# inputs). Requires -DENABLE_ONNX_SEG=ON and Video Mask = seg; runs a YOLO-pose model on the
# same camera frame as seg. Export a model with ./export_pose_model.sh (needs `pip install
# ultralytics`), which writes ~/.projectM/models/yolo11n-pose.onnx. $PROJECTM_POSE_MODEL overrides.
# Leave unset to disable pose. (Current state: tracker-first -- detections are logged; the
# pose->touch bridge is being built.)
#Video Pose Model = ~/.projectM/models/yolo11n-pose.onnx
