---
# Copy this file to all.yml and edit. all.yml is git-ignored because it holds a password.
#
# Intended flow — build + install the bundle first, then run this playbook for the system pieces
# the bundle can't do (autostart + auto-login):
#   macOS:  just deploy-macos && just deploy-to-user <user>   (bundle at /Users/<user>/projectm)
#   Linux:  sudo -E just deploy-linux                          (system tree at /opt/projectm)
# If the bundle already seeded config.inp you can skip the config role: ./bootstrap.sh --skip-tags config
#
# The macOS values are shown live below; the Linux (/opt/projectm) equivalents are in the
# commented block beside each. On Linux, uncomment those and comment out the macOS lines.

# --- Appliance account -------------------------------------------------------------------
appliance_user: brpl
appliance_user_fullname: "projectM Appliance"
# Kiosk account password. On macOS it also seeds auto-login (/etc/kcpassword). On Linux, GDM
# auto-login needs NO stored password, so this is optional there (used only for manual login/su).
appliance_user_password: "changeme"
# Linux only: extra groups the kiosk user needs for the camera/GPU/audio devices (default shown).
# appliance_user_groups: ["video", "render", "audio", "input"]

# Enable automatic login for the appliance user (macOS kcpassword / Linux GDM). False = manual.
enable_autologin: true

# --- projectM binary + presets -----------------------------------------------------------
# macOS deploy bundle at /Users/<user>/projectm:
projectm_binary: "/Users/brpl/projectm/bin/projectM-Test-UI"
projectm_preset_path: "/Users/brpl/projectm/share/projectm/presets/video"
# Linux system tree at /opt/projectm (uncomment for Linux). projectm_binary is unused on Linux —
# the XDG autostart entry runs /opt/projectm/run-projectm.sh (override with projectm_run_script).
# projectm_run_script: "/opt/projectm/run-projectm.sh"
# projectm_preset_path: "/opt/projectm/share/projectm/presets/video"

# ...or a favorites list file (leave empty to use projectm_preset_path):
projectm_preset_list: ""

# --- Visualizer config (written to ~/.projectM/config.inp by the config role) -------------
projectm_fullscreen: true

# Capture-source preference order, highest first, ';'-separated, case-insensitive substrings.
# First present device wins; otherwise the system default is used. Leave empty for default.
projectm_audio_devices: "BlackHole"
projectm_video_devices: "Camera"

# Foreground masking. "seg" = ONNX person segmentation on the webcam; empty/"off" to disable.
projectm_video_mask: "seg"
projectm_seg_quality: 2
# Seg model path. Empty = default ($HOME/.projectM/models/rvm_mobilenetv3.onnx). On the Linux /opt
# bundle the appliance user's home has no models, so point these at /opt/projectm/models/...:
# projectm_seg_model: "/opt/projectm/models/rvm_mobilenetv3.onnx"
# Optional monocular depth gate (drops background people). Empty = off.
# projectm_seg_depth_model: "/opt/projectm/models/depth_anything_v2_vits.onnx"
# projectm_seg_depth_band: 0.20
# Optional matte hardening (smoothstep alpha contrast). Leave unset for off (raw matte).
# projectm_seg_harden_lo: 0.0
# projectm_seg_harden_hi: 1.0

# Texture search path ("~" expands to $HOME; the deploy bundle seeds ~/.projectM/textures).
projectm_texture_path: "~/.projectM/textures"

# Optional extra projectM config values (defaults shown).
projectm_fps: 60
projectm_preset_duration: 30
projectm_mesh_x: 60
projectm_mesh_y: 40
projectm_beat_sensitivity: 1.0
