[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
per_frame_1=// Motion-reactive alpha. Static pixels stay dark; moving pixels light up.

fWaveEnable=0
fDecay=0
warp=0.000000
wave_a=0

// Mode 2 = motion detection. Library computes per-pixel alpha as the magnitude of
// the RGB difference vs. the previous frame, scaled by video_alpha_value.
per_frame_2=video_alpha_mode = 2;
per_frame_3=video_alpha_value = 4.0;
per_frame_4=video_alpha_init = 0.0;

// Render the current frame's RGB modulated by its motion-derived alpha.
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = GetPixel(uv);
comp_4=`    float4 vid = GetVideo(uv, 0.0);
comp_5=`    ret = ret + vid.rgb * vid.a;
comp_6=`}
