[preset00]
// use wavecode
// red circle wave with blue squiggly wave

// Required so the warp_/comp_ shaders below are actually used (else projectM ignores them).
MILKDROP_PRESET_VERSION=201
PSVERSION_WARP=2
PSVERSION_COMP=2

fAlphaInit=1.0
fDecay=0.950000
nWaveMode=0
bMaximizeWaveColor=1
fWaveAlpha=0
fWaveScale=0.5
fZoomExponent=1.000000
zoom=1.100000
warp=0.000000
sx=1.000000
sy=1.000000
wave_r=0.00000
wave_g=0.0000
wave_b=0.00000
wave_a=0.00000
wave_x=0.500000
wave_y=0.5000000

wavecode_0_enabled=1
wavecode_0_mode=0
wavecode_0_bDrawThick=0
wavecode_0_bAdditive=1
wavecode_0_scaling=1.000000
wavecode_0_smoothing=0.500000
wavecode_0_r=0.000000
wavecode_0_g=1.000000
wavecode_0_b=1.000000
wavecode_0_a=1.000000
wavecode_0_av=1;
wave_0_per_point1=x=x+value1/2;
wave_0_per_point2=y=y+value2/2;

per_frame_1=zoom=1.05


Warp: keep RGB feedback (trails) and fade the per-pixel alpha state.
warp_1=`shader_body
warp_2=`{   
warp_3=`    float4 PX = tex2D(sampler_main, uv);
warp_4=`    ret = saturate(PX.rgb * 0.97 - 0.005);
warp_5=`    ret_a = saturate(PX.a * 0.95 - 0.1); 
warp_6=`}

// Comp: use the per-pixel alpha state (.a) as a gray->full-color control.
comp_1=`shader_body
comp_2=`{
comp_3=`    float4 PX = tex2D(sampler_main, uv);
comp_4=`
comp_5=`
comp_6=`    float  g = lum(PX.rgb);
comp_7=`    ret = saturate(lerp(float3(g,g,g), PX.rgb, PX.a));
comp_8=`}
