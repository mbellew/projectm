[preset00]
// Required so the custom warp_/comp_ shaders below are actually used. Without a version >= 200
// (and the per-shader PSVERSION_* levels), projectM ignores warp_/comp_ blocks entirely and falls
// back to the fixed-function path -- which is why GetVideo never ran here.
MILKDROP_PRESET_VERSION=201
PSVERSION_WARP=2
PSVERSION_COMP=2

// Need persistence (decay>0) so the warped previous frame is visible. Set to 0 = no trails.
fDecay=0.9

// MilkdropWaveform
fWaveAlpha=0
fWaveScale=1

// Per-pixel warp confined to the edge regions:
//   left of x=0.35  -> push content toward the left  (dx < 0)
//   right of x=0.65 -> push content toward the right (dx > 0)
//   middle band (0.35..0.65) is left untouched.
// Strength ramps with distance past the boundary, so it reads like a zoom/stretch toward each edge.
// Increase/decrease the 0.12 to make the effect stronger/weaker; flip its sign to swap directions.
per_pixel_1=lz = max(0, 0.33 - x);
per_pixel_2=rz = max(0, x - 0.67);
per_pixel_3=dx = 0.12*(rz - lz);
per_pixel_4=warp = 0; // 0.2*(lz+rz>0);

// CustomWaveform
wavecode_0_enabled=1
wavecode_0_scaling=0.05
wavecode_0_smoothing=0.00
wavecode_0_r=0.000000

wavecode_0_g=1.000000
wavecode_0_b=1.000000
wavecode_0_a=1.000000
wave_0_per_point1=y=sample;
wave_0_per_point2=x=0.35+value1;


wavecode_1_enabled=1
wavecode_1_scaling=0.05
wavecode_1_smoothing=0.00
wavecode_1_r=1.000000
wavecode_1_g=1.000000
wavecode_1_b=0.000000
wavecode_1_a=1.000000
wave_1_per_point1=y=sample;
wave_1_per_point2=x=0.65+value2;

// video_alpha_mode selects how the per-pixel video alpha (vid.a from GetVideo) is computed:
//   0 = Source      : alpha as-is from the source (1.0 for opaque RGB/X cameras; the app-supplied
//                     alpha for true RGBA sources). Whole frame is "opaque".
//   1 = Motion      : alpha = per-pixel RGB difference vs the previous video frame, scaled by
//                     video_alpha_value. Only moving parts get alpha.
//   2 = Constant    : alpha = video_alpha_value (clamped 0..1). Uniform see-through whole frame.
//   3 = MotionDecay : alpha = max(motion, previous_alpha * video_alpha_decay). Motion that lingers
//                     and fades; video_alpha_value scales motion, video_alpha_decay sets persistence.
//   4 = ChromaKey   : alpha from distance to a key color (set via the host API); video_alpha_value
//                     is the tolerance (0 = exact match).
//   5 = BackgroundSubtract : alpha from difference vs a learned background; video_alpha_value is the
//                     threshold, video_alpha_decay is the background learning rate (keep low, ~0.02).
//
// Related params:
//   video_alpha_value : meaning depends on mode (see above). For source/constant, the alpha level.
//   video_alpha_init  : alpha used on the very first frame, before any history exists (0..1).
//   video_alpha_decay : persistence (mode 3) / learning rate (mode 5).
//   video_cleanup     : morphological mask cleanup passes, 0 = off, 1-4 = open+close (modes 1/3/4/5).
per_frame_1=video_alpha_mode = 2;
per_frame_2=video_alpha_value = 1.0;
per_frame_3=video_alpha_decay = 0.9;
per_frame_4=video_alpha_init = 0.0;

// Composite shader: straight copy of the newest video frame to the screen.
warp_1=`shader_body
warp_2=`{
warp_3=`    float4 vid = GetVideo(uv, 0.0);
warp_4=`    float dx = (uv.x - 0.5) * vid.a;
warp_5=`    float2 uvwarp = uv - float2(0.12*dx,0); 
warp_6=`    ret = 0.95 * GetPixel(uvwarp);
warp_7=`}

comp_1=`shader_body
comp_2=`{
comp_3=`    ret = GetPixel(uv);
comp_4=`    float4 vid = GetVideo(uv, 0.0);
comp_5=`    float  g = lum(ret);
comp_6=`    ret = saturate(lerp(float3(g,g,g), ret, vid.a));
comp_7=`
comp_8=`}
