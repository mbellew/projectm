[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
// ---------------------------------------------------------------------------
// Flag/windsock prototype, Option A' ("windsock from the side"):
// 6 points on a string anchored at the center pole.
//
//   * VERTICAL motion = flag flap: additive traveling sines, amplitude grows
//     toward the free tip (s^p). This is the dominant, "up and down" motion.
//   * HORIZONTAL extent = foreshortened projection of a yaw rotation: as the
//     sock swings around the pole, its on-screen width = L * X(t), where
//     X = sign(sin phi) * |sin phi|^xbias  in [-1,1].
//       - |sin phi| alone already lingers at the extremes (arcsine dist);
//       - raising to xbias<1 strengthens that, so x spends LESS time near
//         center (sock pointing at/away from camera) and snaps side to side.
//
// Point i (i=0..5) is at s = i/5 (s=0 pole/center, s=1 free tip).
// Positions computed once into gmegabuf, drawn by one shape (num_inst=6),
// and mirrored into q1..q12 for shaders: point i -> x=q(1+2*i), y=q(2+2*i).
// ---------------------------------------------------------------------------

fDecay=0.9
nMotionVectorsX=0
nMotionVectorsY=0
mv_a=0
zoom=1
rot=0
warp=0.1
dx=0
dy=0
sx=1
sy=1
cx=0.5
cy=0.5
fGammaAdj=1.6
fWaveAlpha=0
wave_a=0
fVideoEchoAlpha=0

// --- yaw rotation -> foreshortened horizontal projection ------------------
per_frame_1=phi = 0.35*time + 0.90*sin(0.13*time) + 0.50*sin(0.071*time);
per_frame_2=xbias = 0.55;
per_frame_3=sp = sin(phi); X = sign(sp) * pow(abs(sp), xbias);
per_frame_4=L = 0.46; sag = 0.05; spd = 0.60;

// --- flap envelope: slow wander + bass pump (bass~1 avg, ~2+ on hits) -----
per_frame_5=gust = 0; // max(0.10, 0.45 + 0.25*sin(0.31*time) + 0.2*(bass_att-1));

// --- compute 6 points: x = foreshortened axis, y = sag + vertical flap ----
per_frame_6=i = 0; loop(6, s = i/5; ampv = pow(s,1.5); flap = ampv*gust*(0.18*sin(6.0*s - 2.3*spd*time) + 0.10*sin(9.7*s - 3.1*spd*time + 1.7) + 0.035*sin(15.3*s - 4.7*spd*time + 4.2)); flapx = ampv*gust*(0.06*sin(5.0*s - 1.9*spd*time + 0.6) + 0.04*sin(8.3*s - 2.7*spd*time + 3.3)); px = 0.5 + s*L*X + flapx; py = 0.5 + sag*s + flap; gmegabuf(i*2)=px; gmegabuf(i*2+1)=py; i=i+1;);

// --- mirror into q-vars for shader access ---------------------------------
per_frame_7=q1=gmegabuf(0); q2=gmegabuf(1); q3=gmegabuf(2); q4=gmegabuf(3); q5=gmegabuf(4); q6=gmegabuf(5);
per_frame_8=q7=gmegabuf(6); q8=gmegabuf(7); q9=gmegabuf(8); q10=gmegabuf(9); q11=gmegabuf(10); q12=gmegabuf(11);
per_frame_9=q13 = decay; q14 = 60 / max(bpm, 1);   // q13=fDecay for feedback; q14=seconds/beat (bpm is eval-only, route to shader via q)

per_frame_10=video_alpha_mode=0

// --- one shape, 6 instances, each reading its precomputed point -----------
shapecode_0_enabled=0
shapecode_0_sides=24
shapecode_0_additive=1
shapecode_0_thickOutline=0
shapecode_0_textured=0
shapecode_0_num_inst=6
shapecode_0_x=0.5
shapecode_0_y=0.5
shapecode_0_rad=0.05
shapecode_0_ang=0
shapecode_0_r=1
shapecode_0_g=0.6
shapecode_0_b=0.2
shapecode_0_a=1
shapecode_0_r2=0.2
shapecode_0_g2=0.1
shapecode_0_b2=0.4
shapecode_0_a2=0
shapecode_0_border_a=0

shape_0_per_frame1=x = sin(beat_phase) + gmegabuf(instance*2);
shape_0_per_frame2=y = gmegabuf(instance*2 + 1);
shape_0_per_frame3=rad = 0.055 - 0.006*instance;
shape_0_per_frame4=r = 0.5 + 0.5*sin(instance*0.9 + time*0.7);
shape_0_per_frame5=g = 0.5 + 0.5*sin(instance*0.9 + time*0.7 + 2.1);
shape_0_per_frame6=b = 0.5 + 0.5*sin(instance*0.9 + time*0.7 + 4.2);
shape_0_per_frame7=a = 1; a2 = 0;

// --- warp shader: shrunken video sprites painted into the FEEDBACK buffer ---
// Output feeds back, so trails persist and fade by the global fDecay (q13).
// point i: center = (q[1+2i], q[2+2i]); depth = i/5*0.25 (0=newest); alpha=0.9^i.
warp_1=```
shader_body
{
    float sc = 0.24; float alphaDecay = 0.9; float sizeDecay = 0.9;   // per-point falloff
    float3 col = GetPixel(uv) * q13;   // decayed feedback (global fDecay)
    float2 pts[6];
    pts[0] = float2(q1, q2);
    pts[1] = float2(q3, q4);
    pts[2] = float2(q5, q6);
    pts[3] = float2(q7, q8);
    pts[4] = float2(q9, q10);
    pts[5] = float2(q11, q12);
    int i;
    for (i = 5; i >= 0; i = i - 1)
    {
        float depth = float(i) * q14 / max(video_buffer_seconds, 0.001);   // q14 = seconds/beat; i beats ago
        //float depth = (float(i) / 5.0) * 0.2;   // newest=0 .. oldest=0.25
        float a = pow(alphaDecay, float(i));
        float sci = sc * pow(sizeDecay, float(i));
        float2 vuv = (uv - pts[i]) / sci + 0.5;
        if (vuv.x > 0.0 && vuv.x < 1.0 && vuv.y > 0.0 && vuv.y < 1.0)
        {
            float4 v = GetVideo(vuv, depth);
            float av = a * v.a;       // frame alpha * decaying sprite alpha
            col = v.rgb * av + col * (1.0 - av);
        }
    }
    ret = col;
}
```
