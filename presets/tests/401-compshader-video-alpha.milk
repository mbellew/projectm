[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2

fDecay=0
warp=0.000000
wave_a=0

per_frame_1=video_alpha_mode = 0;
per_frame_2=video_alpha_value = 4.0;
per_frame_3=video_alpha_decay = 0.90;
per_frame_4=video_alpha_init = 0.0;

// Display current video frame alpha as grayscale
comp_1=`shader_body
comp_2=`{
comp_3=`    float4 vid = GetVideo(uv, 0.0);
comp_4=`    ret = float3(vid.a, vid.a, vid.a);
comp_5=`}
