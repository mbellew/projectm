[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
PALETTE_NAME=neon
fDecay=0
warp=0.000000
wave_a=0
fWaveAlpha=0

// Palette LUT demo: the preset's single palette (PALETTE_NAME=neon) shown as its 2D field —
// x = value t (along the palette), y = knob (the family tweak / image row). Proves Palette(knob,t)
// samples the per-preset 2D LUT.
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = Palette(uv.y, uv.x);
comp_4=`}
