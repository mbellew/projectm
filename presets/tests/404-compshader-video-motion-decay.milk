[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
per_frame_1000=// Motion with persistence. New motion = bright, then fades over many frames.

fDecay=0
warp=0.000000
wave_a=0

// Mode 3 = motion-decay. Library computes per-pixel alpha as
//   max(motion_now * video_alpha_value, prev_alpha * video_alpha_decay)
// so a body moving through the frame leaves a fading trail in the alpha channel.
per_frame_1=video_alpha_mode = 3;
per_frame_2=video_alpha_value = 4.0;
per_frame_3=video_alpha_decay = 0.90;
per_frame_4=video_alpha_init = 0.0;

// Render newest slice, modulated by its motion-persistence alpha.
comp_1=`shader_body
comp_2=`{
comp_3=`    float4 vid = GetVideo(uv, 0.0);
comp_4=`    ret = vid.rgb * vid.a;
comp_5=`}
