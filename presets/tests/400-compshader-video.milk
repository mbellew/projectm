[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
per_frame_1=// Show the most recent video frame full-screen.

fDecay=0
warp=0.000000
wave_a=0

per_frame_2=video_alpha_mode = 0;
per_frame_3=video_alpha_init = 1.0;

// Display current video frame. Screen is transparent black if no video is submitted.
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = GetVideo(uv, 0.0).rgb;
comp_4=`}
