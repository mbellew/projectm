[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2

fDecay=0
warp=0.000000
wave_a=0

per_frame_1=video_alpha_init = 0.0;

// Preset-authored history alpha (the new video_ shader). Instead of the fixed video_alpha_mode,
// the preset computes what goes into the history: here a motion-gated foreground matte. The mask
// buffer (MaskSeg/MaskMotion/...) is current-frame and video-space; GetVideoIn is the live frame.
video_1=`shader_body
video_2=`{
video_3=`    ret   = GetVideoIn(uv);
video_4=`    ret_a = MaskSeg(uv) * MaskMotion(uv);
video_5=`}

// Display the history; virtual green screen visualizes the baked alpha.
comp_1=`shader_body
comp_2=`{
comp_3=`    float4 vid = GetVideo(uv, 0.0);
comp_4=`    ret = lerp(float3(0.0, 1.0, 0.5), vid.rgb, vid.a);
comp_5=`}
