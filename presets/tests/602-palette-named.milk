[preset00]
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
PALETTE_NAME=neon
fDecay=0.97
wave_a=0
fWaveAlpha=0
// Thick border whose color sweeps along the named "neon" palette (knob fixed at 0.7 = vivid).
// t wraps in [0,1] so it cycles. Verifies palette_r/g/b(knob, t) resolve to the preset palette.
ob_size=0.45
ob_a=1.000
ib_size=0.000
per_frame_1=q1 = 0.5 + 0.5*sin(time*0.7);
per_frame_2=ob_r = palette_r(0.7, q1);
per_frame_3=ob_g = palette_g(0.7, q1);
per_frame_4=ob_b = palette_b(0.7, q1);
per_frame_5=monitor = ob_r;
