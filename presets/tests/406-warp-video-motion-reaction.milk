// Derived from source preset: "Geiss - Skin Dots 10b.milk"
MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fRating=5.000000
fGammaAdj=1.000000
fDecay=1.000000
fVideoEchoZoom=2.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=1
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0
fWaveScale=0.397108
fWaveSmoothing=0.000000
fWaveParam=0.240000
fModWaveAlphaStart=0.750000
fModWaveAlphaEnd=1.170000
fWarpAnimSpeed=0.451118
fWarpScale=3.039840
fZoomExponent=2.194764
fShader=0.000000
zoom=1.079709
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.098617
sx=1.000000
sy=1.000000
wave_r=1.000000
wave_g=0.999999
wave_b=1.000000
wave_x=0.500000
wave_y=0.500000
ob_size=0.010000
ob_r=0.000000
ob_g=0.000000
ob_b=0.000000
ob_a=0.000000
ib_size=0.010000
ib_r=0.250000
ib_g=0.250000
ib_b=0.250000
ib_a=0.000000
nMotionVectorsX=64.000000
nMotionVectorsY=48.000000
mv_dx=0.000000
mv_dy=0.000000
mv_l=0.000000
mv_r=0.350000
mv_g=0.350000
mv_b=0.350000
mv_a=0.000000
b1n=0.000000
b2n=0.000000
b3n=0.000000
b1x=1.000000
b2x=1.000000
b3x=1.000000
b1ed=0.250000
wavecode_0_enabled=0
wavecode_1_enabled=0
wavecode_2_enabled=0
wavecode_3_enabled=0
shapecode_0_enabled=0
shapecode_1_enabled=0
shapecode_2_enabled=0
shapecode_3_enabled=0
per_frame_1=wave_r = wave_r + 0.350*( 0.60*sin(0.980*time) + 0.40*sin(1.047*time) );
per_frame_2=wave_g = wave_g + 0.350*( 0.60*sin(0.835*time) + 0.40*sin(1.081*time) );
per_frame_3=wave_b = wave_b + 0.350*( 0.60*sin(0.814*time) + 0.40*sin(1.011*time) );
per_frame_4=cx = cx + 0.110*( 0.60*sin(0.374*time) + 0.40*sin(0.294*time) );
per_frame_5=cy = cy + 0.110*( 0.60*sin(0.393*time) + 0.40*sin(0.223*time) );
per_frame_6=decay = decay - 0.01*equal(frame%20,0);
per_frame_7=zoom = zoom + 5.2*(0.01*cos(time*0.317+1) + 0.01*cos(time*0.1132+4)) + (bass_att - 1)*0.05;
per_frame_8=rot  = rot  + 0.5*(0.01*cos(time*0.214+3) + 0.01*cos(time*0.2732+2));
per_frame_9=wave_mystery = time*0.05;
per_frame_10=// --- video motion detection ---
per_frame_11=// Mode 1: library computes per-pixel video alpha as the RGB-difference
per_frame_12=// magnitude vs. the previous video frame, scaled by video_alpha_value.
per_frame_13=video_alpha_mode = 1;
per_frame_14=video_alpha_value = 2.0;
per_frame_15=video_alpha_init = 0.0;
warp_1=`shader_body
warp_2=`{
warp_3=`    // sample previous frame (the feedback buffer, warped by zoom/rot/warp)
warp_4=`    ret = tex2D( sampler_main, uv ).xyz;
warp_5=`
warp_6=`    // reaction-diffusion: add back (crisp - blurred), then fade slightly.
warp_7=`    // Creates spots and stripes over time.
warp_8=`    ret += (ret - GetBlur1(uv))*0.1;
warp_9=`    ret *= 0.9;
warp_10=`
warp_11=`   // add noise to keep the diffusion alive
warp_12=`   float2 dither_uv = uv_orig*texsize.xy*texsize_noise_lq.zw * 0.4 + rand_frame.xy;
warp_13=`   ret += (tex2D(sampler_noise_lq, dither_uv).x-0.5)/256.0 * 20;
warp_14=`
warp_15=`   // desaturate ovefr time so aged feedback trails settle into white globs
warp_16=`   ret = lerp(ret, lum(ret), 0.1);
warp_17=`
warp_18=`   // inject live video ONLY where motion is detected. With video_alpha_mode=1
warp_19=`   // vid.a is the per-pixel motion magnitude (scaled by video_alpha_value).
warp_20=`   // Apply a hard noise floor: any alpha below video_floor is forced to 0 so
warp_21=`   // sensor noise / static background is fully ignored and those regions keep
warp_22=`   // the reaction-diffusion look. Above the floor the alpha is used as-is, so
warp_23=`   // only genuinely moving parts of the image show through.
warp_24=`   // Sample at uv_orig (un-warped) so the camera stays fixed in screen space
warp_25=`   // while the zoom/warp above drag the freshly injected pixels inward.
warp_26=`   float2 v = uv - 0.5;
warp_27=`   float dist = length(v);
warp_28=`   float radius = 0.2;        // circle radius in centered-uv units
warp_29=`   float softness = 0.05;     // width of the feathered edge
warp_30=`   if (dist < radius) {
warp_31=`    // edge alpha: 1.0 in the interior, ramping to 0.0 over the last
warp_32=`    // softness band so the circle blends smoothly into the surroundings.
warp_33=`    float edge = smoothstep(radius, radius - softness, dist);
warp_34=`    float4 vid = GetVideo(v*2+0.5, 0.0);
warp_35=`    // treble lowers the motion floor, so hi-hats/snares reveal more camera.
warp_36=`    // treb_att is ~1.0 at average level; louder treble drops the floor toward 0.05.
warp_37=`    float video_floor = max(0.05, 0.2 - (treb_att - 1.0)*0.12);
warp_38=`    float motion = vid.a * step(video_floor, vid.a);
warp_39=`    ret = lerp(ret, vid.rgb, motion * edge);
warp_40=`   }
warp_41=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    ret = tex2D(sampler_main, uv).xyz;
comp_4=`}
